{
  "name": "@sda/desktop",
  "version": "0.1.7",
  "private": true,
  "description": "SDA desktop — Electron shell around the web build",
  "main": "./main.cjs",
  "scripts": {
    "dev": "electron . --dev",
    "build": "pnpm --filter @sda/web build && electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "@sda/web": "workspace:*",
    "electron": "^43.3.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.sda.desktop",
    "productName": "SDA",
    "files": [
      "main.cjs",
      "preload.cjs",
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
