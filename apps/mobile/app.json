{
  "expo": {
    "name": "SDA",
    "slug": "sda",
    "version": "0.9.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c101c",
    "ios": {
      "bundleIdentifier": "app.sda.mobile",
      "infoPlist": {
        "NSMotionUsageDescription": "SDA 使用兼容耳机的头部运动数据控制空间音频方向。",
        "NSLocalNetworkUsageDescription": "开启远程诊断服务时，允许同网络电脑读取 SDA 的播放状态和头部姿态。",
        "UIBackgroundModes": [
          "audio"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "app.sda.bed-channel",
            "UTTypeDescription": "SDAR Bed Channel",
            "UTTypeConformsTo": [
              "public.audio",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "sdar"
              ],
              "public.mime-type": "audio/vnd.sda.bed"
            }
          }
        ]
      },
      "supportsTablet": true,
      "icon": "./assets/app-icon.png",
      "buildNumber": "932"
    },
    "android": {
      "package": "app.sda.mobile",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#202223"
      },
      "versionCode": 932
    },
    "plugins": [
      "./plugins/with-ios-deployment"
    ],
    "scheme": "sda",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "extra": {
      "androidReleaseVersion": "0.9.3A2"
    }
  }
}
