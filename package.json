{
  "name": "sda",
  "version": "0.2.0",
  "private": true,
  "description": "Spatial Decoder App — Dolby TrueHD/E-AC-3(Atmos)/DTS:X object audio decoder & 3D renderer for web, desktop and mobile. Rust decoder core from harletty-bridge compiled to WASM/native.",
  "scripts": {
    "core:build": "node scripts/build-core.mjs",
    "head-tracking:build": "node scripts/build-head-tracking-helper.mjs",
    "head-tracking:stage-driver": "node scripts/stage-head-tracking-driver.mjs",
    "head-tracking:test": "cargo test --manifest-path apps/head-tracking-helper/Cargo.toml --locked --offline",
    "head-tracking:test-js": "node scripts/test-head-tracking.mjs",
    "hrtf:build": "node scripts/build-hrtf.mjs",
    "hrtf:calibrate": "node scripts/build-calibrated-hrtf.mjs",
    "hrtf:analyze": "node scripts/analyze-hrtf-calibration.mjs",
    "hrtf:verify": "node scripts/verify-hrtf-assets.mjs",
    "acoustics:test": "node scripts/test/acoustics.test.mjs && node scripts/test/hrtf-source.test.mjs && node scripts/test/impulse-metrics.test.mjs",
    "dev": "pnpm --parallel --filter @sda/web --filter @sda/desktop dev",
    "web:dev": "pnpm --filter @sda/web dev",
    "web:build": "pnpm --filter @sda/web build",
    "desktop:dev": "pnpm --filter @sda/desktop dev",
    "mobile:start": "pnpm --filter @sda/mobile start"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fengluoxiao/SDA.git"
  }
}
