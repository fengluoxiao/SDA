# Keep shared audio metadata identical in Windows, Android and Apple packages.
apps/mobile/ios-experiments/**/*.json text eol=lf
apps/mobile/assets/hrtf-restored/**/*.json text eol=lf
apps/mobile/rendering-presets.json text eol=lf
apps/mobile/assets/hrtf-restored/**/*.txt text eol=lf

assets/hrtf/**/*.json text eol=lf
assets/hrtf/**/*.f32 binary

# Signed catalog package bytes must not change with checkout line endings.
apps/mobile/modules/sda-core/ios/PersonalHrtfNative/MeshOpt/* text eol=lf
apps/mobile/modules/sda-core/ios/Licenses/Meshoptimizer-MIT.txt text eol=lf
apps/head-tracking-driver/package/* -text

# Fixed reference filter bytes and provenance must survive every host checkout.
apps/native-renderer/assets/genelec-reference/*.f32 binary
apps/native-renderer/assets/genelec-reference/*.gz binary
apps/native-renderer/assets/genelec-reference/*.json text eol=lf
apps/native-renderer/assets/genelec-reference/*.md text eol=lf
